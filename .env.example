# Conta master do painel /admin: vê e gerencia tudo, inclusive os logins das profissionais.
# ADMIN_USERNAME é opcional (padrão "master"). Com outro nome, "master" deixa de entrar.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=troque-esta-senha

# Contas das profissionais: usuário = id da profissional, separado da senha por ":".
# Entradas separadas por ";". A senha pode conter ":", mas não ";".
# Também é possível criar o login pelo painel (Serviços → Profissionais e logins), mas esse
# login fica só em memória e some ao reiniciar o servidor. Conta definida aqui prevalece.
ADMIN_USERS=stefani:troque-1;lorrayne:troque-2;michele:troque-3

# URL base da API. Vazio = mesma origem (API de teste em memória em app/api).
# Para o backend definitivo, aponte para ele, ex.: https://api.exemplo.com.br
NEXT_PUBLIC_API_BASE_URL=
